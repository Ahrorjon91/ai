{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "exp": { "type": "number" },
        "unlockedLessonsCount": { "type": "number" },
        "attendancePct": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "LessonProgress": {
      "title": "Lesson Progress",
      "description": "Individual student completion progress for a lesson",
      "type": "object",
      "properties": {
        "lessonId": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "isCompleted": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["lessonId", "userId", "isCompleted"]
    },
    "LabProgress": {
      "title": "Lab Progress",
      "description": "Individual student progress and tasks completed in a lab",
      "type": "object",
      "properties": {
        "labId": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "isCompleted": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["labId", "userId", "isCompleted"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Quiz attempt scores and passed status",
      "type": "object",
      "properties": {
        "quizId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "passed": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["quizId", "userId", "score", "passed"]
    },
    "HomeworkSubmission": {
      "title": "Homework Submission",
      "description": "Submitted homework assignment by a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "lessonId": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "submissionUrl": { "type": "string", "maxLength": 1024 },
        "notes": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["Submitted", "Under Review", "Approved", "Rejected"] },
        "grade": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 1024 },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "lessonId", "userId", "userName", "submissionUrl", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonProgress" },
      "description": "User lesson completion status"
    },
    "/users/{userId}/labs/{labId}": {
      "schema": { "$ref": "#/entities/LabProgress" },
      "description": "User lab completion status"
    },
    "/users/{userId}/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "User quiz attempt result"
    },
    "/homeworkSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/HomeworkSubmission" },
      "description": "Global homework submissions collection for review"
    }
  }
}
